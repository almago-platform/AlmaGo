# Install only after testing on the actual VPS. This unit is NOT activated by GitHub.
[Unit]
Description=AlmaGo encrypted off-site PostgreSQL and Storage backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=almago-backup
Group=almago-backup
EnvironmentFile=/etc/almago/backup.env
Environment=HOME=/var/lib/almago-backup
ExecStart=/usr/local/sbin/almago-offsite-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=almago-backup
ReadWritePaths=/var/tmp /var/lib/almago-backup
