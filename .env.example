# Create these values in your own Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional canonical public origin override for metadata, robots and sitemap.
# Set this to the final HTTPS launch domain when a custom domain is configured.
# SITE_URL=https://www.example.com

# Never expose a secret/service-role key to the browser or commit it to git.

# Partner-ready safety lock. When true, public indexing and externally-effectful
# Phase 2 features stay fail-closed even if another flag is accidentally enabled.
ALMAGO_PARTNER_PRELAUNCH_MODE=false

# Public search-engine indexing. Keep false on development/pre-launch environments.
# Set true only for the approved public launch environment.
ALMAGO_PUBLIC_INDEXING_ENABLED=false

# Phase 2 public funnel. Keep disabled until the orientation rollout is intentionally enabled.
ALMAGO_PHASE2_ENABLED=false

# Phase 2 funnel telemetry transport. Keep false until A38/A44 and an approved analytics provider/config are complete.
ALMAGO_PHASE2_FUNNEL_TELEMETRY_ENABLED=false

# Phase 2 acquisition/referral attribution. Keep false until A38/A44 approve persistence/measurement.
ALMAGO_PHASE2_ATTRIBUTION_ENABLED=false

# Phase 2 prospect persistence. Keep disabled until the privacy notice and backend secret are configured.
ALMAGO_PHASE2_PROSPECT_CAPTURE_ENABLED=false

# Backend-only Supabase key. Use a modern sb_secret_* key, never a NEXT_PUBLIC_* variable.
# SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# P2.3B transactional orientation email. Keep disabled until a verified sending domain is configured.
ALMAGO_PHASE2_EMAIL_DELIVERY_ENABLED=false

# P2.9 payment state-machine orchestration. Keep false until commercial/legal/provider decisions are approved.
ALMAGO_PHASE2_PAYMENT_ORCHESTRATION_ENABLED=false

# Development-only deterministic payment adapter. Ignored in production even if set true.
ALMAGO_PHASE2_DEV_PAYMENT_ADAPTER_ENABLED=false

# P2.4 optional free-account linking. Keep disabled until P2.5 prospect permissions/UI are ready.
ALMAGO_PHASE2_ACCOUNT_LINKING_ENABLED=false

# Free Validation invited-pilot access. Keep false until LEGAL-0 Gate B is approved.
# Even if true, Partner-Ready prelaunch mode forces this capability OFF.
ALMAGO_FREE_VALIDATION_PILOT_ENABLED=false


# Optional provider configuration used only when the email-delivery gate is true.
# SITE_URL must also point to the canonical HTTPS public origin.
# ALMAGO_TRANSACTIONAL_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your-server-only-key
# ALMAGO_TRANSACTIONAL_EMAIL_FROM=Campus Allemagne <orientation@example.com>

# Orientation V4 A2 — server-only university discovery research.
# Keep disabled until an OpenAI API key and production cost/privacy review are ready.
ALMAGO_ORIENTATION_DISCOVERY_PROVIDER=disabled
# OPENAI_API_KEY=sk-your-server-only-key
# ALMAGO_ORIENTATION_DISCOVERY_MODEL=gpt-6-luna

# Orientation V4 B — server-only programme fact verification.
# Keep disabled until provider credentials and production cost/privacy review are ready.
ALMAGO_ORIENTATION_VERIFICATION_PROVIDER=disabled
# Reuses OPENAI_API_KEY from A2 when enabled.
# ALMAGO_ORIENTATION_VERIFICATION_MODEL=gpt-6-luna

# Orientation V4 D — server-only personalized orientation writer.
# Keep disabled until the Gemini credential and production cost/privacy review are ready.
ALMAGO_ORIENTATION_WRITER_PROVIDER=disabled
# GEMINI_API_KEY=your-server-only-key
# ALMAGO_ORIENTATION_WRITER_MODEL=gemini-3.8-flash
