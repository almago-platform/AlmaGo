# Create these values in your own Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional canonical public origin override for metadata, robots and sitemap.
# Set this to the final HTTPS launch domain when a custom domain is configured.
# SITE_URL=https://www.example.com

# Never expose a secret/service-role key to the browser or commit it to git.

# Phase 2 public funnel. Keep disabled until the orientation rollout is intentionally enabled.
ALMAGO_PHASE2_ENABLED=false

# Phase 2 prospect persistence. Keep disabled until the privacy notice and backend secret are configured.
ALMAGO_PHASE2_PROSPECT_CAPTURE_ENABLED=false

# Backend-only Supabase key. Use a modern sb_secret_* key, never a NEXT_PUBLIC_* variable.
# SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# P2.3B transactional orientation email. Keep disabled until a verified sending domain is configured.
ALMAGO_PHASE2_EMAIL_DELIVERY_ENABLED=false

# P2.4 optional free-account linking. Keep disabled until P2.5 prospect permissions/UI are ready.
ALMAGO_PHASE2_ACCOUNT_LINKING_ENABLED=false

# Optional provider configuration used only when the email-delivery gate is true.
# SITE_URL must also point to the canonical HTTPS public origin.
# ALMAGO_TRANSACTIONAL_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your-server-only-key
# ALMAGO_TRANSACTIONAL_EMAIL_FROM=Campus Allemagne <orientation@example.com>
